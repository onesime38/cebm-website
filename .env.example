# Copy to .env.local (never commit it). Values: see docs/GOOGLE_SETUP.md
# Only variables starting with VITE_ are sent to the browser — keep secrets without that prefix.

# Google OAuth (Web client)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Data location (use the STAGING ids locally)
SHEET_ID=
DRIVE_PHOTOS_FOLDER_ID=

# Sessions — generate with: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated Google emails allowed in before the admins tab is filled
BOOTSTRAP_ADMIN_EMAILS=

# Origin allowed for POST/PATCH/DELETE
SITE_ORIGIN=http://localhost:3000

# Phase 3 (public forms)
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
